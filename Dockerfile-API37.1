# Android API 37.1 Jenkins build agent (Linux amd64).
# Build from the repository root:
# docker build --platform linux/amd64 -f Dockerfile-API37.1 -t android-build:api37.1 .
FROM node:22-bullseye-slim AS node
FROM eclipse-temurin:21-jdk-jammy AS sdk-java
FROM eclipse-temurin:17-jdk-jammy

LABEL org.opencontainers.image.authors="paul@paulgobero.com"
ARG ANDROID_TOOLS_VERSION=15859902
ARG ANDROID_PLATFORM_VERSION=37.1
ARG ANDROID_BUILD_TOOLS_VERSION=37.0.0
ARG GRADLE_VERSION=8.14.2
ARG CORDOVA_VERSION=12.0.0

# SDK management uses Java 21 even when the application uses Java 17.
COPY --from=sdk-java /opt/java/openjdk /opt/java/sdk
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    GRADLE_HOME=/opt/gradle \
    TZ=Etc/UTC
ENV ANDROID_BUILD_TOOLS=${ANDROID_HOME}/build-tools/${ANDROID_BUILD_TOOLS_VERSION}
ENV PATH=/opt/gradle/gradle-${GRADLE_VERSION}/bin:${ANDROID_HOME}/platform-tools:${ANDROID_BUILD_TOOLS}:${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin

COPY build-support/install-android.sh /tmp/install-android.sh
RUN bash /tmp/install-android.sh && rm /tmp/install-android.sh

# Jenkins can supply its own uid and mount its workspace here.
WORKDIR /workspace
CMD ["bash"]
